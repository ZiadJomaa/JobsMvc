@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">TOTAL JOBS</span>
                    <h3 class="fw-bold mb-0 text-dark mt-1">@(ViewBag.TotalJobs ?? 0)</h3>
                </div>
                <div class="badge bg-primary-subtle text-primary p-3 rounded-circle fs-4">
                    💼
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">PENDING APPROVAL</span>
                    <h3 class="fw-bold mb-0 text-warning mt-1">@(ViewBag.PendingJobs ?? 0)</h3>
                </div>
                <div class="badge bg-warning-subtle text-warning p-3 rounded-circle fs-4">
                    ⏳
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">CATEGORIES</span>
                    <h3 class="fw-bold mb-0 text-dark mt-1">@(ViewBag.TotalCategories ?? 0)</h3>
                </div>
                <div class="badge bg-info-subtle text-info p-3 rounded-circle fs-4">
                    📂
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">TOTAL USERS</span>
                    <h3 class="fw-bold mb-0 text-dark mt-1">@(ViewBag.TotalUsers ?? 0)</h3>
                </div>
                <div class="badge bg-success-subtle text-success p-3 rounded-circle fs-4">
                    👥
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Statistics -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">TOTAL COMPANIES</span>
                    <h3 class="fw-bold mb-0 text-dark mt-1">
                        @(ViewBag.TotalCompanies ?? 0)
                    </h3>
                </div>
                <div class="badge bg-primary-subtle text-primary p-3 rounded-circle fs-4">
                    🏢
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">APPROVED JOBS</span>
                    <h3 class="fw-bold mb-0 text-success mt-1">
                        @(ViewBag.ApprovedJobs ?? 0)
                    </h3>
                </div>
                <div class="badge bg-success-subtle text-success p-3 rounded-circle fs-4">
                    ✅
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">TOTAL APPLICATIONS</span>
                    <h3 class="fw-bold mb-0 text-dark mt-1">
                        @(ViewBag.TotalApplications ?? 0)
                    </h3>
                </div>
                <div class="badge bg-info-subtle text-info p-3 rounded-circle fs-4">
                    📄
                </div>
            </div>
        </div>
    </div>
</div>
<div class="card border-0 shadow-sm rounded-3 bg-light p-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">System Status</h5>
            <p class="text-muted small mb-0">All management modules are up to date and active.</p>
        </div>
        <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary px-3">
            Review Jobs Pending Approval
        </a>
    </div>
</div>
<div class="card border-0 shadow-sm rounded-3 bg-white p-4 mt-4">
    <h5 class="fw-bold mb-3">Applications by Status</h5>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Applications</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.ApplicationsByStatus != null)
                {
                    foreach (var item in ViewBag.ApplicationsByStatus)
                    {
                        <tr>
                            <td>@item.Status</td>
                            <td>@item.Count</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-muted text-center">
                            No application data available.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>