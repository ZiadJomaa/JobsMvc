@model JobsMvc.Models.Entities.JobPost

@{
    ViewData["Title"] = "Delete Job";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-3">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 text-danger">Delete Job Post</h5>
                <p class="text-muted">Are you sure you want to delete this job listing?</p>

                <div class="p-3 bg-light rounded-2 mb-3">
                    <span class="text-muted small d-block">Job Title</span>
                    <strong class="fs-5 text-dark">@Model.Title</strong>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <span class="text-muted small d-block">Category</span>
                        <span class="fw-semibold">@(Model.Category?.Name ?? "N/A")</span>
                    </div>
                    <div class="col-6">
                        <span class="text-muted small d-block">Location</span>
                        <span class="fw-semibold">@(Model.City?.Name ?? "Remote")</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>