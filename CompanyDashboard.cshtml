@model IEnumerable<JobsMvc.Models.Entities.JobApplication>

@{
    ViewData["Title"] = "Company Dashboard";
}



        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <!-- Statistics -->

        <div class="row g-4 mb-5">

            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <p class="text-muted mb-1">Open Jobs</p>
                        <h2 class="text-primary mb-0">
                            @ViewBag.OpenJobs
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <p class="text-muted mb-1">Total Applicants</p>
                        <h2 class="text-primary mb-0">
                            @ViewBag.TotalApplications
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <p class="text-muted mb-1">New This Week</p>
                        <h2 class="text-success mb-0">
                            @ViewBag.NewApplicationsThisWeek
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <p class="text-muted mb-1">Accepted</p>
                        <h2 class="text-success mb-0">
                            @ViewBag.AcceptedApplications
                        </h2>
                    </div>
                </div>
            </div>

        </div>


        <!-- Status Chart -->

        <div class="card shadow-sm border-0 mb-5">
            <div class="card-body">

                <h4 class="mb-4">
                    Application Status Overview
                </h4>

                <div style="max-width: 600px;">
                    <canvas id="applicationStatusChart"></canvas>
                </div>

            </div>
        </div>


        <!-- Recent Applicants -->

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h4 class="mb-0">
                        Recent Applicants
                    </h4>

                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Job</th>
                                    <th>Applicant</th>
                                    <th>Applied Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var application in Model.Take(10))
                                {
                                    <tr>

                                        <td>
                                            @application.JobPost?.Title
                                        </td>

                                        <td>
                                            @(application.JobSeeker?.FullName
                                                ?? "Unknown Applicant")
                                        </td>

                                       <td>
                                     @(application.AppliedAt.ToLocalTime().ToString("dd/MM/yyyy"))
                                      </td>

                                        <td>
                                            <span class="badge bg-info text-dark">
                                                @application.Status
                                            </span>
                                        </td>

                                        <td>
                                            <a asp-action="ViewApplications"
                                               asp-route-id="@application.JobPostId"
                                               class="btn btn-sm btn-outline-primary">
                                                View Applicants
                                            </a>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        No applicants found yet.
                    </div>
                }

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const ctx =
            document.getElementById('applicationStatusChart');

        new Chart(ctx, {
            type: 'bar',

            data: {
                labels: [
                    'Applied',
                    'Under Review',
                    'Interview',
                    'Accepted',
                    'Rejected'
                ],

                datasets: [{
                    label: 'Applications',

                    data: [
                        @ViewBag.AppliedCount,
                        @ViewBag.UnderReviewCount,
                        @ViewBag.InterviewCount,
                        @ViewBag.AcceptedApplications,
                        @ViewBag.RejectedCount
                    ]
                }]
            },

            options: {
                responsive: true,

                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

    </script>
}