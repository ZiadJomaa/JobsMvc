@model JobsMvc.Models.Entities.JobPost

@{
    ViewData["Title"] = "Delete Job";
}

<h1>Confirm Delete</h1>

<h3 class="text-danger">Are you sure you want to delete this job?</h3>

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Company</dt>
    <dd class="col-sm-9">@Model.Company?.CompanyName</dd>

    <dt class="col-sm-3">City</dt>
    <dd class="col-sm-9">@Model.City?.Name</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>