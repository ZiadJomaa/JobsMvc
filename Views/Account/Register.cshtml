@model JobsMvc.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create New Account";
}

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title text-center text-primary text-uppercase">Join Us</h6>
            <h1 class="mb-5">Create <span class="text-primary text-uppercase">New Account</span></h1>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="wow fadeInUp" data-wow-delay="0.2s">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control" placeholder="Full Name or Company Name" />
                                    <label asp-for="FullName"></label>
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                            <input asp-for="Email" class="form-control" placeholder="Email" />
                                            <label asp-for="Email"></label>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Password" class="form-control" placeholder="Password" />
                                    <label asp-for="Password"></label>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                                    <label asp-for="ConfirmPassword"></label>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Type of Account:</label>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="UserType" value="JobSeeker" id="typeJobSeeker" checked>
                                        <label class="form-check-label" for="typeJobSeeker">Job Seeker</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="UserType" value="Company" id="typeCompany">
                                        <label class="form-check-label" for="typeCompany">Company</label>
                                    </div>
                                </div>
                                <span asp-validation-for="UserType" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-primary w-100 py-3" type="submit">Register</button>
                            </div>
                            <div class="col-12 text-center">
                                <p class="mb-0">you have an account? <a asp-action="Login" class="text-primary fw-bold">Sign in</a></p>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}