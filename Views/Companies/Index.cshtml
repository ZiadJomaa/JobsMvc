@model IEnumerable<JobsMvc.Models.Entities.CompanyProfile>

@{
    ViewData["Title"] = "Companies";
}

<div class="container my-4">
    <h2 class="mb-4">Explore Companies</h2>

    <!-- Search & Filter Form -->
    <form method="get" asp-action="Index" class="row g-3 mb-4">
        <div class="col-md-5">
            <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Search by company name..." />
        </div>
        <div class="col-md-5">
            <select name="industry" class="form-select">
                <option value="">All Industries</option>
                @if (ViewBag.Industries != null)
                {
                    foreach (var ind in (List<string>)ViewBag.Industries)
                    {
                        <option value="@ind" selected="@(ind == ViewBag.SelectedIndustry)">@ind</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>

    <!-- Companies Cards -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12"><p class="text-muted">No companies found.</p></div>
        }
        else
        {
            @foreach (var company in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@company.CompanyName</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@company.Industry</h6>
                            <a asp-action="Details" asp-route-id="@company.Id" class="btn btn-outline-primary btn-sm mt-3">View Profile</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>