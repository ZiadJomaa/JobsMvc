@using JobsMvc.ViewModel
@model CompanyProfileFormViewModel

@{
    ViewData["Title"] = "Edit Company Profile";
}

<h1>Edit Company Profile</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Industry" class="form-label"></label>
        <input asp-for="Industry" class="form-control" />
        <span asp-validation-for="Industry" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LogoPath" class="form-label"></label>
        <input asp-for="LogoPath" class="form-control" placeholder="/uploads/logos/company.png" />
        <small class="text-muted d-block">Temporary text field — will become a real file upload later.</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Approval Status</label>
        <div>
            @if (Model.IsApproved)
            {
                <span class="badge bg-success">Approved</span>
            }
            else
            {
                <span class="badge bg-secondary">Pending Admin Approval</span>
            }
        </div>
        <small class="text-muted">Only an Admin can change this.</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Operating Cities</label>
        <div class="border rounded p-2" style="max-height:200px; overflow-y:auto;">
            @foreach (var city in Model.AllCities)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="SelectedCityIds" value="@city.Id"
                           id="city_@city.Id"
                           checked="@(Model.SelectedCityIds.Contains(city.Id))" />
                    <label class="form-check-label" for="city_@city.Id">@city.Name</label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Profile" asp-route-id="@Model.Id" class="btn btn-secondary">Back to Profile</a>
</form>