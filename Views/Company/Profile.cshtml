@using JobsMvc.Models.Entities
@model CompanyProfile
@{
    ViewData["Title"] = "Company Profile";
}

<div class="container-xxl py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                @if (!Model.IsApproved)
                {
                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>
                            <strong>Account Pending:</strong> Your company profile is currently under review by the administrator.
                        </div>
                    </div>
                }

                <div class="card shadow-sm border-0 p-4 p-md-5 mb-5 rounded-3">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="d-flex align-items-center">
                            <img src="@(string.IsNullOrEmpty(Model.LogoPath) ? "/img/com-logo-1.jpg" : Model.LogoPath)" 
                                 class="rounded shadow-sm me-3 border p-1" 
                                 style="width: 80px; height: 80px; object-fit: contain;" alt="Logo" />
                            <div>
                                <h3 class="mb-1 text-primary fw-bold">@Model.CompanyName</h3>
                                <span class="badge @(Model.IsApproved ? "bg-success" : "bg-warning text-dark")">
                                    @(Model.IsApproved ? "Approved" : "Pending Approval")
                                </span>
                            </div>
                        </div>
                        <a asp-action="Edit" class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i> Edit Profile
                        </a>
                    </div>

                    <div class="row g-4 pt-3 border-top">
                        <div class="col-md-6">
                            <label class="fw-bold text-muted small d-block">Industry</label>
                            <span class="fs-6 fw-semibold text-dark">
                                @(string.IsNullOrEmpty(Model.Industry) ? "Not specified" : Model.Industry)
                            </span>
                        </div>

                        <div class="col-12">
                            <label class="fw-bold text-muted small d-block mb-2">Operating Cities</label>
                            <div>
                                @if (Model.OperatingCities != null && Model.OperatingCities.Any())
                                {
                                    @foreach (var companyCity in Model.OperatingCities)
                                    {
                                        <span class="badge bg-light text-dark border px-3 py-2 me-1 mb-1">
                                            <i class="bi bi-geo-alt text-primary me-1"></i>@(companyCity.City?.Name ?? "Unknown")
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No operating cities specified yet.</span>
                                }
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>