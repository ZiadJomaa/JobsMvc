@{
    ViewData["Title"] = "About Us";
}

<!-- Page Header Start -->
<div class="container-xxl py-5 bg-dark page-header mb-5" style="background: linear-gradient(rgba(43, 57, 64, .7), rgba(43, 57, 64, .7)), url('/jobentry/img/carousel-1.jpg') center center no-repeat; background-size: cover;">
    <div class="container my-5 pt-5 pb-4">
        <h1 class="display-3 text-white mb-3 animated slideInDown">About Us</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb text-uppercase">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-white active" aria-current="page">About</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="row g-2 about-bg rounded overflow-hidden">
                    <div class="col-6 text-start">
                        <img class="img-fluid rounded w-100" src="/jobentry/img/about-1.jpg" style="object-fit: cover; height: 200px;">
                    </div>
                    <div class="col-6 text-start">
                        <img class="img-fluid rounded w-100" src="/jobentry/img/about-2.jpg" style="object-fit: cover; height: 200px;">
                    </div>
                    <div class="col-6 text-end">
                        <img class="img-fluid rounded w-100" src="/jobentry/img/about-3.jpg" style="object-fit: cover; height: 200px;">
                    </div>
                    <div class="col-6 text-end">
                        <img class="img-fluid rounded w-100" src="/jobentry/img/about-4.jpg" style="object-fit: cover; height: 200px;">
                    </div>
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h1 class="mb-4">We Help To Get The Best Job And Find A Talent</h1>
                <p class="mb-4">Our platform bridges the gap between ambitious job seekers and top-tier companies. We provide a seamless, reliable, and fast recruitment experience tailored to modern market needs.</p>
                <p><i class="fa fa-check text-primary me-3"></i>Verified and trusted job listings</p>
                <p><i class="fa fa-check text-primary me-3"></i>Direct connection with top employers</p>
                <p><i class="fa fa-check text-primary me-3"></i>User-friendly dashboard for management</p>
                <a asp-controller="JobPosts" asp-action="Index" class="btn btn-primary py-3 px-5 mt-3">Search A Job</a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->

<!-- Mission & Vision Start -->
<div class="container-xxl py-5 bg-light my-5">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <h1 class="mb-3">Our Core Values</h1>
            <p>We are committed to transforming the recruitment process through innovation, transparency, and efficiency.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="service-item bg-white rounded h-100 p-4 shadow-sm">
                    <div class="service-icon mb-3">
                        <i class="fa fa-3x fa-bullseye text-primary"></i>
                    </div>
                    <h5 class="mb-3">Our Mission</h5>
                    <p class="m-0">To empower professionals by providing them with accessible career opportunities while helping companies scale with the right talent efficiently.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="service-item bg-white rounded h-100 p-4 shadow-sm">
                    <div class="service-icon mb-3">
                        <i class="fa fa-3x fa-eye text-primary"></i>
                    </div>
                    <h5 class="mb-3">Our Vision</h5>
                    <p class="m-0">To become the leading employment ecosystem recognized for reliability, smart matching workflows, and seamless user experience.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="service-item bg-white rounded h-100 p-4 shadow-sm">
                    <div class="service-icon mb-3">
                        <i class="fa fa-3x fa-hands-helping text-primary"></i>
                    </div>
                    <h5 class="mb-3">Why Choose Us</h5>
                    <p class="m-0">Built using robust modern technologies (.NET Core MVC) ensuring high security, fast performance, and a smooth administrative control panel.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Mission & Vision End -->