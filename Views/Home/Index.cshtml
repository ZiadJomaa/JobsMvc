@using JobsMvc.ViewModels.Home
@model HomeViewModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>JobEntry - Job Portal Website Template</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="/jobentry/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/jobentry/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/jobentry/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/jobentry/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/jobentry/css/style.css" rel="stylesheet">
</head>

<body>
    <div class="container-fliud bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->
        
        <!-- Carousel Start -->
        <div class="container-fluid p-0">
            <div class="owl-carousel header-carousel position-relative">
                <div class="owl-carousel-item position-relative">
                    <img class="img-fluid" src="/jobentry/img/carousel-1.jpg" alt="">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" style="background: rgba(43, 57, 64, .5);">
                        <div class="container">
                            <div class="row justify-content-start">
                                <div class="col-10 col-lg-8">
                                    <h1 class="display-3 text-white animated slideInDown mb-4">Find Your Dream Job Or Hire Top Talent Today</h1>
                                    <p class="fs-5 fw-medium text-white mb-4 pb-2">Connect with thousands of employers, explore career opportunities matched to your skills, and take the next big step in your professional journey.</p>
                                   <a asp-controller="JobPosts" asp-action="Index" class="btn btn-primary py-md-3 px-md-5 me-3 animated slideInLeft">Search A Job</a>
                                   <a asp-controller="Companies" asp-action="Index" class="btn btn-secondary py-md-3 px-md-5 animated slideInRight">Find A Talent</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="owl-carousel-item position-relative">
                    <img class="img-fluid" src="/jobentry/img/carousel-2.jpg" alt="">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" style="background: rgba(43, 57, 64, .5);">
                        <div class="container">
                            <div class="row justify-content-start">
                                <div class="col-10 col-lg-8">
                                    <h1 class="display-3 text-white animated slideInDown mb-4">Find The Best Startup Job That Fit You</h1>
                                    <p class="fs-5 fw-medium text-white mb-4 pb-2">Connect with innovative startups and find the perfect role that aligns with your passion and expertise.</p>
                                    <a asp-controller="JobPosts" asp-action="Index" class="btn btn-primary py-md-3 px-md-5 me-3 animated slideInLeft">Search A Job</a>
                                    <a asp-controller="Companies" asp-action="Index" class="btn btn-secondary py-md-3 px-md-5 animated slideInRight">Find A Talent</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Carousel End -->
<!-- Search Start -->
<div class="container-fluid bg-primary mb-5 wow fadeIn" data-wow-delay="0.1s" style="padding: 35px;">
    <div class="container">
        <form asp-controller="Home" asp-action="Index" asp-fragment="job-listing" method="get" class="row g-2">
            <div class="col-md-10">
                <div class="row g-2">
                    <div class="col-md-4">
                        <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control border-0" placeholder="Search by job title..." />
                    </div>
                    <div class="col-md-4">
                        <select name="categoryId" class="form-select border-0">
                            <option value="">All Categories</option>
                            @if (Model.Categories != null)
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id" selected="@(ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString())">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select name="cityId" class="form-select border-0">
                            <option value="">All Cities</option>
                            @if (Model.Cities != null)
                            {
                                foreach (var city in Model.Cities)
                                {
                                    <option value="@city.Id" selected="@(ViewData["CurrentCity"]?.ToString() == city.Id.ToString())">@city.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark border-0 w-100 h-100">Search</button>
            </div>
        </form>
    </div>
</div>
<!-- Search End -->
        <!-- Category Start -->
        <div class="container-xxl py-5">
            <div class="container">
                <h1 class="text-center mb-5 wow fadeInUp" data-wow-delay="0.1s">Explore By Category</h1>
                <div class="row g-4">

                    @if (Model != null && Model.Categories != null)
                    {
                        @foreach (var category in Model.Categories)
                        {
                            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                                <a class="cat-item rounded p-4" href="#">
                                    <i class="fa fa-3x fa-mail-bulk text-primary mb-4"></i>
                                    <h6 class="mb-3">@category.Name</h6>
                                    <p class="mb-0">@category.JobCount Vacancy</p>
                                </a>
                            </div>
                        }
                    }

                </div>
            </div>
        </div>
        <!-- Category End -->

 <!-- About Start -->
        <div class="container-fliud py-5">
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                        <div class="row g-0 about-bg rounded overflow-hidden">
                            <div class="col-6 text-start">
                                <img class="img-fluid w-100" src="/jobentry/img/about-1.jpg">
                            </div>
                            <div class="col-6 text-start">
                                <img class="img-fluid" src="/jobentry/img/about-2.jpg" style="width: 85%; margin-top: 15%;">
                            </div>
                            <div class="col-6 text-end">
                                <img class="img-fluid" src="/jobentry/img/about-3.jpg" style="width: 85%;">
                            </div>
                            <div class="col-6 text-end">
                                <img class="img-fluid w-100" src="/jobentry/img/about-4.jpg">
                            </div>
                        </div>
                    </div>
                        <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                        <h1 class="mb-4">We Help You Get The Best Job And Find Top Talent</h1>
                        <p class="mb-4">JobEntry is your ultimate gateway to career success. Whether you are a professional looking for your next breakthrough or a company searching for exceptional talent, we make the hiring process seamless and efficient.</p>
                        <p><i class="fa fa-check text-primary me-3"></i>Verified and trusted job listings from top companies</p>
                        <p><i class="fa fa-check text-primary me-3"></i>Smart matching system tailored to your skills</p>
                        <p><i class="fa fa-check text-primary me-3"></i>Direct communication between job seekers and employers</p>
                        <a asp-controller="JobPosts" asp-action="Index" class="btn btn-primary py-3 px-5 mt-3">Explore Jobs</a>
                    </div>
                </div>
            </div>
        </div>
        <!-- About End -->

<!-- Jobs Start -->
<div id="job-listing" class="container-xxl py-5">
    <div class="container">
        <h1 class="text-center mb-5 wow fadeInUp" data-wow-delay="0.1s">Job Listing</h1>
        <div class="tab-class text-center wow fadeInUp" data-wow-delay="0.3s">
            <div class="tab-content">
                <div id="tab-1" class="tab-pane fade show p-0 active">
                    @if (Model != null && Model.NewestJobs != null && Model.NewestJobs.Any())
                    {
                        foreach (var job in Model.NewestJobs)
                        {
                            <div class="job-item p-4 mb-4">
                                <div class="row g-4">
                                    <div class="col-sm-12 col-md-8 d-flex align-items-center">
                                        <img class="flex-shrink-0 img-fluid border rounded" src="/jobentry/img/com-logo-1.jpg" alt="" style="width: 80px; height: 80px;">
                                        <div class="text-start ps-4">
                                            <h5 class="mb-3">@job.Title</h5>
                                            <span class="text-truncate me-3">
                                                <i class="fa fa-map-marker-alt text-primary me-2"></i>@(job.City?.Name ?? "Remote")
                                            </span>
                                            <span class="text-truncate me-0">
                                                <i class="far fa-money-bill-alt text-primary me-2"></i>@job.JobType
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-4 d-flex flex-column align-items-start align-items-md-end justify-content-center">
                                        <div class="d-flex mb-3 gap-2">
                                            <a class="btn btn-primary" asp-controller="Home" asp-action="Details" asp-route-id="@job.Id">View Details</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">No jobs available right now.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Jobs End -->
      <!-- Testimonial Start -->
        <div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
            <div class="container">
                <h1 class="text-center mb-5">Success Stories From Our Users</h1>
                <div class="owl-carousel testimonial-carousel">
                    
                    <!-- Item 1 -->
                    <div class="testimonial-item bg-light rounded p-4">
                        <i class="fa fa-quote-left fa-2x text-primary mb-3"></i>
                        <p>"JobEntry helped me land my dream remote developer job in less than two weeks! The platform is super intuitive and fast."</p>
                        <div class="d-flex align-items-center">
                            <img class="img-fluid flex-shrink-0 rounded" src="/jobentry/img/testimonial-1.jpg" style="width: 50px; height: 50px;">
                            <div class="ps-3">
                                <h5 class="mb-1">Ahmed Mohamed</h5>
                                <small>Software Engineer</small>
                            </div>
                        </div>
                    </div>

                    <!-- Item 2 -->
                    <div class="testimonial-item bg-light rounded p-4">
                        <i class="fa fa-quote-left fa-2x text-primary mb-3"></i>
                        <p>"As an HR manager, finding qualified candidates used to take ages. With JobEntry, we hired top-tier engineers seamlessly."</p>
                        <div class="d-flex align-items-center">
                            <img class="img-fluid flex-shrink-0 rounded" src="/jobentry/img/testimonial-2.jpg" style="width: 50px; height: 50px;">
                            <div class="ps-3">
                                <h5 class="mb-1">Sara Ali</h5>
                                <small>HR Director</small>
                            </div>
                        </div>
                    </div>

                    <!-- Item 3 -->
                    <div class="testimonial-item bg-light rounded p-4">
                        <i class="fa fa-quote-left fa-2x text-primary mb-3"></i>
                        <p>"The application tracking feature is amazing. I could easily monitor my interview status and connect directly with employers."</p>
                        <div class="d-flex align-items-center">
                            <img class="img-fluid flex-shrink-0 rounded" src="/jobentry/img/testimonial-3.jpg" style="width: 50px; height: 50px;">
                            <div class="ps-3">
                                <h5 class="mb-1">Mahmoud Khaled</h5>
                                <small>Frontend Developer</small>
                            </div>
                        </div>
                    </div>

                    <!-- Item 4 -->
                    <div class="testimonial-item bg-light rounded p-4">
                        <i class="fa fa-quote-left fa-2x text-package mb-3"></i>
                        <i class="fa fa-quote-left fa-2x text-primary mb-3"></i>
                        <p>"An exceptional platform! The smart job categories and filters saved me a lot of time searching for relevant openings."</p>
                        <div class="d-flex align-items-center">
                            <img class="img-fluid flex-shrink-0 rounded" src="/jobentry/img/testimonial-4.jpg" style="width: 50px; height: 50px;">
                            <div class="ps-3">
                                <h5 class="mb-1">Nourhan Youssef</h5>
                                <small>UI/UX Designer</small>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <!-- Testimonial End -->
        

      <!-- Footer Start -->
        <div class="container-fluid bg-dark text-white-50 footer pt-5 mt-5 wow fadeIn" data-wow-delay="0.1s">
            <div class="container py-5">
                <div class="row g-5">
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">JobEntry</h5>
                        <p class="mb-3">Your ultimate platform to bridge the gap between talented professionals and top-tier companies worldwide.</p>
                        <div class="d-flex pt-2">
                            <a class="btn btn-outline-light btn-social" href=""><i class="fab fa-twitter"></i></a>
                            <a class="btn btn-outline-light btn-social" href=""><i class="fab fa-facebook-f"></i></a>
                            <a class="btn btn-outline-light btn-social" href=""><i class="fab fa-youtube"></i></a>
                            <a class="btn btn-outline-light btn-social" href=""><i class="fab fa-linkedin-in"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Quick Links</h5>
                        <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="btn btn-link text-white-50" asp-controller="JobPosts" asp-action="Index">Explore Jobs</a>
                        <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="Companies">Companies</a>
                        <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="About">About Us</a>
                        <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="Contact">Contact Us</a>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Contact Info</h5>
                        <p class="mb-2"><i class="fa fa-map-marker-alt me-3"></i>Cairo, Egypt</p>
                        <p class="mb-2"><i class="fa fa-phone-alt me-3"></i>+20 123 456 7890</p>
                        <p class="mb-2"><i class="fa fa-envelope me-3"></i>support@jobentry.com</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Newsletter</h5>
                        <p>Subscribe to get the latest job alerts and career tips straight to your inbox.</p>
                        <div class="position-relative mx-auto" style="max-width: 400px;">
                            <input class="form-control bg-transparent w-100 py-3 ps-4 pe-5 text-white" type="text" placeholder="Your email">
                            <button type="button" class="btn btn-primary py-2 position-absolute top-0 end-0 mt-2 me-2">Join</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="copyright">
                    <div class="row">
                        <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                            &copy; <a class="border-bottom text-white" href="#">JobEntry</a>, All Right Reserved.
                        </div>
                        <div class="col-md-6 text-center text-md-end">
                            <div class="footer-menu">
                                <a asp-controller="Home" asp-action="Index">Home</a>
                                <a href="">Cookies</a>
                                <a href="">Help</a>
                                <a href="">FAQs</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End -->


        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

</body>

</html>