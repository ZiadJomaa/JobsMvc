@model JobsMvc.Models.Entities.JobPost

@{
    ViewData["Title"] = "Job Details";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>@Model.Title</h1>

<dl class="row">
    <dt class="col-sm-3">Company</dt>
    <dd class="col-sm-9">
        @Model.Company?.CompanyName
        @if (!string.IsNullOrEmpty(Model.CompanyId))
        {
            <a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.CompanyId" class="btn btn-sm btn-outline-info ms-2">
                View Profile
            </a>
        }
    </dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.JobType</dd>

    <dt class="col-sm-3">Experience Level</dt>
    <dd class="col-sm-9">@Model.ExperienceLevel</dd>

    <dt class="col-sm-3">Salary</dt>
    <dd class="col-sm-9">@Model.MinSalary - @Model.MaxSalary</dd>

    <dt class="col-sm-3">City</dt>
    <dd class="col-sm-9">@Model.City?.Name</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category?.Name</dd>

    <dt class="col-sm-3">Closing Date</dt>
    <dd class="col-sm-9">@(Model.ClosingDate?.ToString("dd/MM/yyyy") ?? "Not specified")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Closed")</dd>

    <dt class="col-sm-3">Required Skills</dt>
    <dd class="col-sm-9">
        @if (Model.RequiredSkills != null && Model.RequiredSkills.Any())
        {
            foreach (var rs in Model.RequiredSkills)
            {
                <span class="badge bg-primary me-1">@rs.Skill?.Name</span>
            }
        }
    </dd>
</dl>

<div class="mt-3 mb-3">
    <form asp-controller="JobPosts" asp-action="Apply" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="jobPostId" value="@Model.Id" />
        <button type="submit" class="btn btn-success btn-lg">Apply Now</button>
    </form>

    @if (User.IsInRole("Company"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning ms-1">Edit</a>
    }

    <a asp-action="Index" class="btn btn-secondary ms-1">Back</a>
</div>