@model IEnumerable<JobsMvc.Models.Entities.JobPost>

@{
    ViewData["Title"] = "Job Posts";
}

<h1>Job Posts</h1>

<p>
    @if (User.IsInRole("Company"))
    {
        <a asp-action="Create" class="btn btn-primary">
            + Add New Job
        </a>
    }
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Company</th>
            <th>City</th>
            <th>Category</th>
            <th>Type</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.Title</td>
                <td>@job.Company?.CompanyName</td>
                <td>@job.City?.Name</td>
                <td>@job.Category?.Name</td>
                <td>@job.JobType</td>
                <td>
                    @if (job.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Closed</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Company"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@job.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@job.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>

                        @if (job.IsActive)
                        {
                            <form asp-action="Close"
                                  asp-route-id="@job.Id"
                                  method="post"
                                  style="display:inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-dark"
                                        onclick="return confirm('Are you sure you want to close this job?')">
                                    Close
                                </button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>