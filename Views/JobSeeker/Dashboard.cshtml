@{
    ViewData["Title"] = "Job Seeker Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <div class="mb-4">
        <h2 class="fw-bold">Job Seeker Dashboard</h2>
        <p class="text-muted">Track your job applications and manage your profile.</p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                <h6 class="text-muted">TOTAL APPLICATIONS</h6>
                <h2 class="fw-bold mt-2">
                    @(ViewBag.TotalApplications ?? 0)
                </h2>
                <a asp-action="MyApplications"
                   class="btn btn-outline-primary mt-3">
                    View Applications
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                <h6 class="text-muted">ACTIVE APPLICATIONS</h6>
                <h2 class="fw-bold mt-2">
                    @(ViewBag.PendingApplications ?? 0)
                </h2>
                <a asp-action="MyApplications"
                   class="btn btn-outline-warning mt-3">
                    Track Status
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                <h6 class="text-muted">ACCEPTED APPLICATIONS</h6>
                <h2 class="fw-bold mt-2 text-success">
                    @(ViewBag.AcceptedApplications ?? 0)
                </h2>
                <a asp-action="MyApplications"
                   class="btn btn-outline-success mt-3">
                    View Results
                </a>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-3 mt-4 p-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-1">Your Profile</h5>
                <p class="text-muted mb-0">
                    Keep your profile and resume up to date.
                </p>
            </div>

            <div>
                <a asp-action="EditProfile"
                   class="btn btn-primary me-2">
                    Edit Profile
                </a>

                <a asp-action="Resumes"
                   class="btn btn-outline-secondary">
                    Manage Resumes
                </a>
            </div>
        </div>
    </div>

</div>