@model JobsMvc.ViewModels.JobSeekerProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container-xxl py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card shadow-sm border-0 p-4 p-md-5 mb-5 rounded-3">
                    <h3 class="mb-4 text-primary fw-bold">Edit Profile</h3>
                    <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ExistingPhotoPath" />

                        <div class="text-center mb-4">
                            <img src="@(string.IsNullOrEmpty(Model.ExistingPhotoPath) ? "/img/default-avatar.png" : Model.ExistingPhotoPath)" 
                                 class="rounded-circle shadow-sm mb-3 border border-2 border-primary" 
                                 style="width: 120px; height: 120px; object-fit: cover;" alt="Profile Picture" />
                            <div class="col-md-6 mx-auto">
                                <label asp-for="PhotoFile" class="form-label fw-bold small text-muted">Change Profile Picture</label>
                                <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" />
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-bold">Full Name</label>
                                <input asp-for="FullName" class="form-control py-2" placeholder="John Doe" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-bold">Job Title / Headline</label>
                                <input asp-for="Title" class="form-control py-2" placeholder="e.g. Full-Stack .NET Developer" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExperienceYears" class="form-label fw-bold">Years of Experience</label>
                                <input asp-for="ExperienceYears" type="number" min="0" class="form-control py-2" placeholder="3" />
                                <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CityId" class="form-label fw-bold">City</label>
                                <select asp-for="CityId" asp-items="Model.CitiesList" class="form-select py-2">
                                    <option value="">-- Select City --</option>
                                </select>
                                <span asp-validation-for="CityId" class="text-danger small"></span>
                            </div>
                            <div class="col-12 mt-4">
                                <label class="form-label fw-bold d-block mb-2">Technical Skills</label>
                                <div class="row g-2 p-3 bg-light rounded-3 border">
                                    @foreach (var skill in Model.SkillsList)
                                    {
                                        <div class="col-md-3 col-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="SelectedSkillIds" value="@skill.Value" 
                                                       id="skill_@skill.Value" @(Model.SelectedSkillIds.Contains(int.Parse(skill.Value)) ? "checked" : "") />
                                                <label class="form-check-label small" for="skill_@skill.Value">@skill.Text</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-12 d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                                <a asp-action="Resumes" class="btn btn-outline-secondary px-4 py-2">
                                    <i class="bi bi-file-earmark-text me-1"></i> Manage Resumes (CVs)
                                </a>
                                <button type="submit" class="btn btn-primary px-5 py-2 fw-bold">Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}