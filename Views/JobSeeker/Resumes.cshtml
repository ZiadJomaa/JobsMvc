@model IEnumerable<JobsMvc.Models.Entities.Resume>
@{
    ViewData["Title"] = "Manage Resumes";
}

<div class="container-xxl py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card shadow border-0 p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="text-primary mb-0">Upload New Resume</h4>
                        <a asp-action="EditProfile" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-arrow-left me-1"></i> Back to Profile
                        </a>
                    </div>
                    
                    <form asp-action="UploadResume" method="post" enctype="multipart/form-data" class="row g-3">
                        <div class="col-md-5">
                            <input type="text" name="title" class="form-control" placeholder="Resume Title (e.g., .NET Backend CV)" />
                        </div>
                        <div class="col-md-5">
                            <input type="file" name="resumeFile" class="form-control" accept=".pdf" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Upload</button>
                        </div>
                        <small class="text-muted">Only PDF files are accepted.</small>
                    </form>
                </div>

                <div class="card shadow border-0 p-4">
                    <h4 class="text-primary mb-4">Your Uploaded Resumes</h4>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-file-earmark-pdf text-muted display-4"></i>
                            <p class="text-muted mt-2">You haven't uploaded any resumes yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Title</th>
                                        <th>Uploaded Date</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var resume in Model)
                                    {
                                        <tr>
                                            <td class="fw-bold">
                                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                                @resume.Title
                                            </td>
                                            <td>@resume.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (resume.IsDefault)
                                                {
                                                    <span class="badge bg-success">Default CV</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark">Alternative</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a href="@resume.FilePath" target="_blank" class="btn btn-sm btn-outline-primary me-2">
                                                    <i class="bi bi-eye"></i> View
                                                </a>

                                                @if (!resume.IsDefault)
                                                {
                                                    <form asp-action="SetDefaultResume" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@resume.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                                            Set as Default
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>