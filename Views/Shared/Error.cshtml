@model ErrorViewModel
@{
    ViewData["Title"] = "500 - Server Error";
}

<div class="container-xxl py-5 bg-dark page-header mb-5">
    <div class="container my-5 pt-5 pb-4">
        <h1 class="display-3 text-white mb-3 animated slideInDown">500 Error</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb text-uppercase">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-white active" aria-current="page">Server Error</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <i class="bi bi-gear-wide-connected display-1 text-danger"></i>
                <h1 class="display-1">500</h1>
                <h1 class="mb-4">Internal Server Error</h1>
                <p class="mb-4">Something went wrong on our end. Please try again later.</p>
                
                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }
                
                <a class="btn btn-primary py-3 px-5 mt-3" asp-controller="Home" asp-action="Index">Go Back To Home</a>
            </div>
        </div>
    </div>
</div>
