<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobEntry</title>

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/jobentry/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/jobentry/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/jobentry/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/jobentry/css/style.css" rel="stylesheet" asp-append-version="true">
</head>
<body>
    <div class="container-fluid bg-white p-0">
        <!-- Spinner Start (لو التمبلت فيه spinner) -->
        @* <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div> *@
        <!-- Spinner End -->
       
<!-- Navbar Start -->
        <nav class="navbar navbar-expand-lg bg-white navbar-light shadow sticky-top p-0">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center text-center py-0 px-4 px-lg-5">
                <h1 class="m-0 text-primary">JobEntry</h1>
            </a>
            <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto p-4 p-lg-0">
                    <a asp-controller="Home" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>
                    <a asp-controller="JobPosts" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "JobPosts" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Jobs</a>
                    <a asp-controller="Companies" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Companies" ? "active" : "")">Companies</a>
                    
                    <!-- AI Assistant Link -->
                    <a asp-controller="Ai" asp-action="Ask" class="nav-item nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ai" ? "active" : "")">AI Assistant</a>

                    <!-- Dashboard Link for Company Role Only -->
                    @if (User.IsInRole("Company"))
                    {
                        <a asp-controller="JobPosts" asp-action="CompanyDashboard" class="nav-item nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "CompanyDashboard" ? "active" : "")">Dashboard</a>
                    }

                    <a asp-controller="Home" asp-action="About" class="nav-item nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "About" ? "active" : "")">About</a>
                    <a asp-controller="Home" asp-action="Contact" class="nav-item nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")">Contact</a>
                </div>
                
                <!-- Login Partial or Auth Buttons -->
                <partial name="_LoginPartial" />
                @if (User.IsInRole("Company"))
                {
                    <a asp-controller="JobPosts"
                       asp-action="Create"
                       class="btn btn-primary rounded-0 py-4 px-lg-5 d-none d-lg-block">
                        Post A Job
                        <i class="fa fa-arrow-right ms-3"></i>
                    </a>
                }
            </div>
        </nav>
        <!-- Main Body -->
        <main role="main">
            @RenderBody()
        </main>


        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/jobentry/lib/wow/wow.min.js"></script>
    <script src="~/jobentry/lib/easing/easing.min.js"></script>
    <script src="~/jobentry/lib/waypoints/waypoints.min.js"></script>
    <script src="~/jobentry/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/jobentry/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>