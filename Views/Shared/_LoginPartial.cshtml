@using Microsoft.AspNetCore.Identity
@using JobsMvc.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="navbar-nav ms-auto p-4 p-lg-0 align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("JobSeeker"))
    {
        <a class="nav-item nav-link" asp-controller="JobSeeker" asp-action="EditProfile">Profile</a>
    }
    else if (User.IsInRole("Company"))
    {
        <a class="nav-item nav-link" asp-controller="Company" asp-action="Profile">Company Profile</a>
    }
    else if (User.IsInRole("Admin"))
    {
  <a class="nav-link text-danger fw-bold" 
   asp-area="Admin" 
   asp-controller="Admin" 
   asp-action="Admins">
    ADMIN PANEL
  </a>
    }

    <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="nav-item nav-link btn btn-link text-uppercase text-secondary border-0" style="text-decoration:none;">
            Logout (@User.Identity?.Name?.Split('@')[0])
        </button>
    </form>
}
else
{
    <a class="nav-item nav-link" asp-controller="Account" asp-action="Register">REGISTER</a>
    <a class="nav-item nav-link" asp-controller="Account" asp-action="Login">LOGIN</a>
}
</div>
